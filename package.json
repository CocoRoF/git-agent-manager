    "ai-agents",
    "mcp",
    "github",
    "milestones",
    "planning",
    "claude-code",
    "codex",
    "dashboard"
  ],
  "homepage": "https://github.com/CocoRoF/git-agent-manager#readme",
  "bugs": "https://github.com/CocoRoF/git-agent-manager/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CocoRoF/git-agent-manager.git"
  },
  "license": "Apache-2.0",
  "author": "CocoRoF",
  "type": "module",
  "bin": {
    "git-agent-manager": "dist/cli.js",
    "gam": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
